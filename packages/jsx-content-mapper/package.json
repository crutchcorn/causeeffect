{
  "name": "@causeeffect/jsx-content-mapper",
  "version": "0.0.2",
  "type": "module",
  "description": "TypeScript content mapper for generator-preserving JSX in .gtsx files",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "scripts": {
    "build": "node node_modules/typescript/bin/tsc -p tsconfig.lib.json",
    "test": "vitest run",
    "typecheck": "node node_modules/typescript/bin/tsc -b",
    "lint": "eslint ."
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    "./runtime": {
      "@causeeffect/source": "./src/runtime.ts",
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js",
      "default": "./dist/runtime.js"
    },
    "./vite": {
      "@causeeffect/source": "./src/vite.ts",
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "default": "./dist/vite.js"
    },
    ".": {
      "@causeeffect/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "typescript": {
    "contentMapper": {
      "exec": [
        "node",
        "dist/server.js"
      ],
      "compilerOptions": [
        "jsxFactory",
        "jsxFragmentFactory"
      ],
      "dynamicConfig": false
    }
  },
  "dependencies": {
    "@babel/parser": "^7.29.9",
    "@babel/types": "^7.29.0",
    "@jridgewell/gen-mapping": "^0.3.13",
    "ts-content-mapper": "^0.1.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "effect": "4.0.0",
    "typescript": "~6.0.3",
    "typescript-next": "npm:typescript@7.1.0-dev.20261002.1",
    "vite": "^8.1.4"
  },
  "peerDependencies": {
    "vite": "^8.1.4"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "nx": {
    "tags": [
      "scope:jsx-content-mapper"
    ],
    "targets": {
      "format-check": {
        "command": "prettier --check . --ignore-path ../../.prettierignore",
        "options": {
          "cwd": "packages/jsx-content-mapper"
        }
      }
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crutchcorn/causeeffect.git",
    "directory": "packages/jsx-content-mapper"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
